export default async function handler(req, res) {
  if (req.method !== 'POST') {
    return res.status(405).json({ error: 'Método no permitido' });
  }

  const { prompt } = req.body;

  if (!prompt) {
    return res.status(400).json({ error: 'El prompt es obligatorio' });
  }

  // Modelo de realismo o FLUX en Hugging Face (puedes cambiarlo si usas otro Space/Modelo)
  const MODEL_ID = "black-forest-labs/FLUX.1-schnell";

  try {
    const response = await fetch(`https://api-inference.huggingface.co/models/${MODEL_ID}`, {
      method: 'POST',
      headers: {
        'Authorization': `Bearer ${process.env.HF_TOKEN}`,
        'Content-Type': 'application/json',
      },
      body: JSON.stringify({ inputs: prompt }),
    });

    if (!response.ok) {
      const errorText = await response.text();
      return res.status(500).json({ error: 'Error en Hugging Face: ' + errorText });
    }

    // Convertimos la imagen devuelta a Base64 para enviarla al frontend
    const arrayBuffer = await response.arrayBuffer();
    const base64Image = Buffer.from(arrayBuffer).toString('base64');
    const imageUrl = `data:image/jpeg;base64,${base64Image}`;

    return res.status(200).json({ image: imageUrl });
  } catch (error) {
    return res.status(500).json({ error: 'Error interno del servidor' });
  }
}
